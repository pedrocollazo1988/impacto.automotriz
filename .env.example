DATABASE_URL="postgresql://user:pass@localhost:5432/impacto"
APP_SECRET="cadena-larga-aleatoria"        # cifra la clave SMTP, firma bajas y la sesión de admin
PUBLIC_URL="http://localhost:3000"         # dominio público (sin barra final)
CRON_SECRET="otra-cadena-larga"            # protege /api/cron/campaigns
ADMIN_PASSWORD="cambia-esta-clave"         # acceso al panel /admin/login
NEXT_PUBLIC_WHATSAPP="53XXXXXXXX"          # número con código de país, sin +
BANK_INSTRUCTIONS="Banco / cuenta / titular para transferencias"
# Tropipay (sandbox: https://www.tropipay-dev.com · producción: https://www.tropipay.com)
TROPIPAY_BASE_URL="https://www.tropipay-dev.com"
TROPIPAY_CLIENT_ID=""
TROPIPAY_CLIENT_SECRET=""
TROPIPAY_REASON_ID="4"                     # validar en la documentación de Tropipay
AGENT_API_KEY=""                           # clave de solo lectura para el agente de IA (/api/agent/products)
NEXT_PUBLIC_GA_ID=""                       # Google Analytics 4 (G-XXXXXXX), opcional
ADMIN_EMAIL="admin@tudominio.com"           # primer administrador (se crea al iniciar sesión por primera vez con ADMIN_PASSWORD)
BLOB_READ_WRITE_TOKEN=""                   # opcional: Vercel Blob para fotos/modelos 3D. Vacío = disco local (UPLOAD_DIR)
UPLOAD_DIR="./uploads"
GOOGLE_CLIENT_ID=""                        # opcional: inicio de sesión con Google (redirect: PUBLIC_URL/api/account/google/callback)
GOOGLE_CLIENT_SECRET=""
QVAPAY_APP_ID=""                           # opcional: segunda pasarela
QVAPAY_APP_SECRET=""
QVAPAY_BASE_URL="https://qvapay.com"
# Cloudflare Turnstile (opcional). El registro ya usa un captcha propio firmado
# con APP_SECRET. Si defines las dos claves, Turnstile lo sustituye en el
# registro y protege el resto de formularios públicos. Deben pertenecer al
# mismo sitio.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Correo transaccional (alternativa a configurarlo en /admin/campanas).
# Si no hay fila EmailSettings, se usan estas variables. Imprescindible en Vercel
# para que lleguen los códigos de verificación y los correos de pedidos.
SMTP_HOST="smtp.tuproveedor.com"
SMTP_PORT="587"
SMTP_SECURE="false"                         # true para puerto 465
SMTP_USER="ventas@tudominio.com"
SMTP_PASS="clave-o-app-password"
MAIL_FROM_EMAIL="ventas@tudominio.com"
MAIL_FROM_NAME="Impacto Automotriz"
MAIL_REPLY_TO="ventas@tudominio.com"

# ───────── Autenticación por teléfono (SMS) ─────────
# Proveedor: mock | twilio | vonage | infobip | whatsapp. Si se deja vacío se usa el
# primero cuyas credenciales estén completas; sin credenciales, "mock"
# (imprime el código en la consola del servidor y no envía nada).
SMS_PROVIDER="mock"
SMS_MOCK_ECHO="false"                       # true (solo en desarrollo) devuelve el código en la API
SMS_FROM="Impacto"                          # remitente para Vonage/Infobip

# Twilio (Programmable SMS). TWILIO_MESSAGING_SERVICE_SID sustituye a TWILIO_FROM.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
TWILIO_MESSAGING_SERVICE_SID=""

# Vonage (Nexmo)
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_FROM=""

# Infobip
INFOBIP_API_KEY=""
INFOBIP_BASE_URL=""                         # p. ej. xxxxx.api.infobip.com
INFOBIP_FROM=""

# WhatsApp Cloud API (Meta). Para Cuba es la vía más fiable: el mensaje viaja
# por datos, no por la red de SMS. Necesita una cuenta de Meta Business, un
# número de negocio dado de alta y una plantilla de categoría "authentication"
# con un parámetro {{1}} (el código) aprobada en el idioma de WHATSAPP_TEMPLATE_LANG.
WHATSAPP_TOKEN=""                           # token permanente del sistema
WHATSAPP_PHONE_ID=""                        # id del número de negocio (no el teléfono)
WHATSAPP_TEMPLATE="codigo_acceso"           # plantilla aprobada con {{1}} = código
WHATSAPP_TEMPLATE_LANG="es"                 # idioma de la plantilla: es | en_US ...
WHATSAPP_TEMPLATE_PRUEBA=""                 # opcional: plantilla sin parámetros para la prueba del panel
